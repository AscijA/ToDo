<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:ToDo.Maui"
             xmlns:components="clr-namespace:ToDo.RazorLib.Components;assembly=ToDo.RazorLib"
             xmlns:routes="clr-namespace:ToDo.RazorLib.Routes;assembly=ToDo.RazorLib"
             x:Class="ToDo.Maui.MainPage">

    <BlazorWebView x:Name="blazorWebView" HostPage="wwwroot/index.html">
        <BlazorWebView.RootComponents>
            <RootComponent Selector="#app" ComponentType="{x:Type routes:Index}" />
        </BlazorWebView.RootComponents>
    </BlazorWebView>

</ContentPage>
