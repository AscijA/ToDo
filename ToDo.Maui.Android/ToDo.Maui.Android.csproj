<Project Sdk="Microsoft.NET.Sdk.Razor">

	<Import Project="Signing\signing.props" Condition="Exists('Signing\signing.props')" />

	<PropertyGroup>
		<TargetFramework>net10.0-android</TargetFramework>
		<OutputType>Exe</OutputType>
		<RootNamespace>ToDo.Maui.Android</RootNamespace>
		<UseMaui>true</UseMaui>
		<SingleProject>true</SingleProject>
		<ImplicitUsings>enable</ImplicitUsings>
		<EnableDefaultCssItems>false</EnableDefaultCssItems>
		<Nullable>enable</Nullable>

		<ApplicationTitle>To Do</ApplicationTitle>
		<ApplicationId>ba.ascija.todo.maui.android</ApplicationId>
		<ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
		<ApplicationVersion>1</ApplicationVersion>

		<SupportedOSPlatformVersion>24.0</SupportedOSPlatformVersion>
		<AndroidUseLegacyIconGeneration>false</AndroidUseLegacyIconGeneration>
	</PropertyGroup>

	<PropertyGroup Condition="'$(Configuration)' == 'Release'">
		<AndroidPackageFormats>apk</AndroidPackageFormats>
	</PropertyGroup>

	<ItemGroup>
		<MauiIcon Include="Resources\AppIcon\appicon.png" BaseSize="128,128" Color="#000000" ForegroundScale="0.65" />

		<MauiSplashScreen Include="Resources\AppIcon\appicon.png" BaseSize="128,128" ForegroundScale="0.55" />
	</ItemGroup>

	<ItemGroup>
		<MauiAsset Include="Resources\Raw\AboutAssets.txt" LogicalName="%(RecursiveDir)%(Filename)%(Extension)" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.Maui.Controls" Version="$(MauiVersion)" />
		<PackageReference Include="Microsoft.AspNetCore.Components.WebView.Maui" Version="$(MauiVersion)" />
		<PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="10.0.0" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\ToDo.Application\ToDo.Application.csproj" />
		<ProjectReference Include="..\ToDo.Infrastructure\ToDo.Infrastructure.csproj" />
		<ProjectReference Include="..\ToDo.RazorLib\ToDo.RazorLib.csproj" />
	</ItemGroup>
</Project>
