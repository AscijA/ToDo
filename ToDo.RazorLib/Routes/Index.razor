@page "/"
@using ToDo.RazorLib.Components
<MudThemeProvider Theme="ODPTheme.Theme"
                  IsDarkMode="true"
                  ObserveSystemDarkModeChange="false" />
<MudDialogProvider />
<MudSnackbarProvider />
<MudPopoverProvider />
<PageTitle>Planner Dashboard</PageTitle>

<div class="planner-dashboard">
   <aside class="sidebar" aria-label="Primary">
      <div class="sidebar-spacer"></div>
      <MudIconButton Icon="@Icons.Material.Filled.Add" aria-label="New" Color="Color.Primary" />
   </aside>

   <MudSplitPanel @ref="_splitPanel"
                  Class="split-container mud-width-full mud-height-full"
                  Horizontal="false"
                  Rounded="true"
                  Elevation="0"
                  >
      <FirstPanel>
         <MudPaper Class="panel-daily mud-height-full rounded" Elevation="1">
            <DailyPlanner />
         </MudPaper>
      </FirstPanel>

      <SecondPanel>
         <MudStack StretchItems="StretchItems.All" Class="rounded mud-height-full" Spacing="2">
            <MudPaper Class="panel-weekly rounded" Elevation="1">
               <WeeklyPlanner />
            </MudPaper>

            <MudPaper Class="panel-monthly rounded" Elevation="1">
               <MonthlyPlanner/>
            </MudPaper>
         </MudStack>
      </SecondPanel>
   </MudSplitPanel>
</div>

@code {
	private MudSplitPanel? _splitPanel;
}