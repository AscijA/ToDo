@page "/mobile"
@using ToDo.RazorLib.Components.DailyPlanner
@using ToDo.RazorLib.Components.WeeklyPlanner
@using ToDo.RazorLib.Components.MonthlyPlanner
@using ToDo.RazorLib.Components.TaskList
@using ToDo.RazorLib.Components.Common
@using ToDo.RazorLib.Components.Mobile
@using ToDo.Application.Contracts.DTOs
@using ToDo.Application.Interfaces.Services
@using ToDo.RazorLib.Services
@inject ITaskListService ListService
@inject IDialogService DialogService
@inject ISettingsService SettingsService
@inject SyncModalRequestService SyncModalRequests
@inject ThemeStoreInterop ThemeStore
@implements IDisposable

<MudThemeProvider @ref="_mudThemeProvider"
                 Theme="_currentTheme"
                 @bind-IsDarkMode="_isDarkMode" />
<MudDialogProvider />
<MudSnackbarProvider />
<MudPopoverProvider />

<div class="mobile-shell">
    <div class="@GetMobileContentClass()">
        @switch (_activeTab) {
            case 0:
                <DailyPlanner />
                break;
            case 1:
                <WeeklyPlanner />
                break;
            case 2:
                <MonthlyPlanner />
                break;
            case 3:
                <MobileTaskListsView TaskLists="_taskLists"
                                     SelectedListId="_selectedListId"
                                     OnListSelected="SelectList"
                                     OnAddNewList="AddNewList"
                                     OnListDeleted="OnListDeleted"
                                     OnListsUpdated="LoadTaskLists" />
                break;
            case 4:
                <MobileMoreView SelectedPage="_morePage"
                                OnPageSelected="OpenMorePage"
                                OnBack="CloseMorePage"
                                OnSettingsSaved="OnSettingsSavedAsync" />
                break;
        }
    </div>

    <MobileBottomBar ActiveTab="_activeTab"
                     ListLetter="@GetSelectedListLetter()"
                     ListTabStyle="@GetListTabColorVar()"
                     OnTabSelected="SetTab" />
</div>

@code {
    private int _activeTab = 0;
    private MobileMorePage _morePage = MobileMorePage.None;
    private List<TaskListDto> _taskLists = new();
    private Guid _selectedListId = Guid.Empty;

    private MudThemeProvider? _mudThemeProvider;
    private string _appearance = "System";
    private bool _isDarkMode = true;
    private MudTheme _currentTheme = Themes.OneDarkPro;

    protected override async Task OnInitializedAsync() {
        SyncModalRequests.OpenRequested += OnSyncModalRequested;
        LoadSettings();
        await LoadTaskLists();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender) {
        if (firstRender) {
            if (_appearance == "System" && _mudThemeProvider != null) {
                await _mudThemeProvider.WatchSystemDarkModeAsync(OnSystemDarkModeChanged);
                var systemDarkMode = await _mudThemeProvider.GetSystemDarkModeAsync();
                if (_isDarkMode != systemDarkMode) {
                    _isDarkMode = systemDarkMode;
                }
            }
            await PersistThemeAsync();
            StateHasChanged();
        }
    }

    private async Task PersistThemeAsync() {
        var (primary, background) = Themes.GetColors(_currentTheme, _isDarkMode);
        await ThemeStore.PersistAsync(primary, background, _isDarkMode);
    }

    private void SetTab(int index) {
        if (_activeTab == 3 && index == 3 && _selectedListId != Guid.Empty) {
            _selectedListId = Guid.Empty;
            return;
        }

        if (index != 4) {
            _morePage = MobileMorePage.None;
        }

        _activeTab = index;
    }

    private void LoadSettings() {
        _appearance = SettingsService.Get("Appearance", "System");
        if (_appearance == "Light")
            _isDarkMode = false;
        else if (_appearance == "Dark")
            _isDarkMode = true;
        // For "System", leave _isDarkMode at its current value — 
        // it will be resolved in OnAfterRenderAsync
        var themeName = SettingsService.Get("Theme", "ODP");
        if (themeName == "Custom") {
            var primary = SettingsService.Get("Custom_Primary", "#C678DD");
            var secondary = SettingsService.Get("Custom_Secondary", "#61AFEF");
            var background = SettingsService.Get("Custom_Background", "#282C34");
            var surface = SettingsService.Get("Custom_Surface", "#21252B");
            _currentTheme = Themes.CreateCustomTheme(primary, secondary, background, surface);
        }
        else {
            _currentTheme = themeName switch {
                "Blue" => Themes.Blue,
                "Solarized" => Themes.Solarized,
                "Green" => Themes.Green,
                _ => Themes.OneDarkPro
            };
        }
    }

    private Task OnSystemDarkModeChanged(bool isDarkMode) {
        if (_appearance == "System") {
            _isDarkMode = isDarkMode;
            _ = PersistThemeAsync();
            StateHasChanged();
        }
        return Task.CompletedTask;
    }

    private async Task LoadTaskLists() {
        for (int i = 0; i < 3; i++) {
            try {
                _taskLists = await ListService.GetAllAsync();
                return;
            }
            catch {
                if (i == 2) throw;
                await Task.Delay(500);
            }
        }
    }

    private void SelectList(Guid id) {
        _selectedListId = id;
    }

    private async Task AddNewList() {
        var dialog = await DialogService.ShowAsync<TaskListModal>("New Task List");
        var result = await dialog.Result;

        if (result != null && !result.Canceled && result.Data is TaskListModal.TaskListModalResult modalResult) {
            var newList = await ListService.CreateAsync(modalResult.Name, modalResult.Color, modalResult.Description);
            await LoadTaskLists();
            SelectList(newList.Id);
        }
    }

    private async Task OnListDeleted() {
        await LoadTaskLists();
        _selectedListId = Guid.Empty;
    }

    private void OnSyncModalRequested() {
        _ = InvokeAsync(() => {
            _activeTab = 4;
            _morePage = MobileMorePage.Sync;
            StateHasChanged();
        });
    }

    private void OpenMorePage(MobileMorePage page) {
        _morePage = page;
    }

    private void CloseMorePage() {
        _morePage = MobileMorePage.None;
    }

    private async Task OnSettingsSavedAsync() {
        LoadSettings();
        await PersistThemeAsync();
        StateHasChanged();
    }

    private string GetIconLetter(string name) =>
        string.IsNullOrWhiteSpace(name) ? "?" : name.Trim()[0].ToString().ToUpperInvariant();

    private string GetSelectedListLetter() {
        var list = _taskLists.FirstOrDefault(l => l.Id == _selectedListId);
        return list != null ? GetIconLetter(list.Name) : "L";
    }

    private string GetListTabColorVar() {
        var list = _taskLists.FirstOrDefault(l => l.Id == _selectedListId);
        var color = list?.Color ?? "var(--mud-palette-primary)";
        return $"--list-tab-color: {color};";
    }

    private string GetMobileContentClass() {
        return _activeTab == 4 && _morePage != MobileMorePage.None
            ? "mobile-content mobile-content-subpage"
            : "mobile-content";
    }

    public void Dispose() {
        SyncModalRequests.OpenRequested -= OnSyncModalRequested;
    }
}
