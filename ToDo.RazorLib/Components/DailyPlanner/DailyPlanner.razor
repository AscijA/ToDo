@inject IDailyPlanService TaskService
@inject ISettingsService SettingsService
@inject SyncDataRefreshService SyncDataRefresh
@implements IDisposable

<PlannerDateHeader Title="@Date.ToString("dddd, dd.MM.yyyy")"
					  SelectedDate="selectedDateTime"
					  PreviousLabel="Previous"
					  NextLabel="Next"
					  OnPrevious="GoToPreviousDay"
					  OnNext="GoToNextDay"
					  OnToday="GoToToday"
					  OnDateSelected="OnDateSelected" />
@foreach (var item in DailyItems) {
	<DailyItem @key="item.OccurrenceId"
				  Daily="item"
				  date="Date"
				  OnSaved="RefreshListAsync" />
}
@if (Date >= DateOnly.FromDateTime(DateTime.Now)) {
	<DailyItem Daily="newItem"
				  date="Date"
				  OnSaved="RefreshListAsync"
				  @key="Guid.NewGuid()"
				  AutoFocus="shouldAutoFocus" />
}

@code {
	private DailyItemDTO newItem = new();

	private const string DatePrefKey = "LastViewedDailyDate";
	public DateOnly Date { get; set; }
	public List<DailyItemDTO> DailyItems { get; set; } = new();

	private DateTime selectedDateTime;

	private bool shouldAutoFocus = false;

	protected override async Task OnInitializedAsync() {
		SyncDataRefresh.RefreshRequested += OnSyncDataRefreshRequested;
		string savedDateStr = SettingsService.Get(DatePrefKey, string.Empty);
		var today = DateOnly.FromDateTime(DateTime.Now);

		if (!string.IsNullOrEmpty(savedDateStr) && DateOnly.TryParse(savedDateStr, out var parsedDate)) {
			Date = parsedDate < today ? today : parsedDate;
		}
		else {
			Date = today;
		}

		SettingsService.Set(DatePrefKey, Date.ToString("yyyy-MM-dd"));
		selectedDateTime = Date.ToDateTime(new TimeOnly(0, 0));

		await LoadTasksAsync();
	}


	private async Task LoadTasksAsync() {
		DailyItems = await TaskService.GetAllDailyOfDateAsync(Date);
		newItem = new DailyItemDTO();
	}
	private async Task RefreshListAsync() {
		shouldAutoFocus = true;
		await LoadTasksAsync();
	}

	private async Task GoToPreviousDay() {
		Date = Date.AddDays(-1);
		await SyncAndReloadAsync();
	}

	private async Task GoToNextDay() {
		Date = Date.AddDays(1);
		await SyncAndReloadAsync();
	}

	private async Task GoToToday() {
		await OnDateSelected(DateTime.Now);
	}

	private async Task OnDateSelected(DateTime? newDate) {
		if (newDate.HasValue) {
			Date = DateOnly.FromDateTime(newDate.Value);
			selectedDateTime = newDate.Value;
			await SyncAndReloadAsync();
		}
	}

	private async Task SyncAndReloadAsync() {
		shouldAutoFocus = false;
		selectedDateTime = Date.ToDateTime(new TimeOnly(0, 0));

		SettingsService.Set(DatePrefKey, Date.ToString("yyyy-MM-dd"));

		await LoadTasksAsync();
	}

	private void OnSyncDataRefreshRequested() {
		_ = InvokeAsync(async () => {
			shouldAutoFocus = false;
			await LoadTasksAsync();
			StateHasChanged();
		});
	}

	public void Dispose() {
		SyncDataRefresh.RefreshRequested -= OnSyncDataRefreshRequested;
	}
}
