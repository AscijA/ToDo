<div class="mobile-bottom-bar">
    <button class="tab-btn @(ActiveTab == 0 ? "active" : "")" @onclick="() => OnTabSelected.InvokeAsync(0)">
        <span class="tab-btn-icon">
            <MudIcon Icon="@Icons.Material.Filled.CalendarToday" Size="Size.Small" />
            <span class="tab-badge">1</span>
        </span>
        <span class="tab-btn-label">Daily</span>
    </button>
    <button class="tab-btn @(ActiveTab == 1 ? "active" : "")" @onclick="() => OnTabSelected.InvokeAsync(1)">
        <span class="tab-btn-icon">
            <MudIcon Icon="@Icons.Material.Filled.CalendarViewWeek" Size="Size.Small" />
            <span class="tab-badge">7</span>
        </span>
        <span class="tab-btn-label">Weekly</span>
    </button>
    <button class="tab-btn @(ActiveTab == 2 ? "active" : "")" @onclick="() => OnTabSelected.InvokeAsync(2)">
        <span class="tab-btn-icon">
            <MudIcon Icon="@Icons.Material.Filled.CalendarMonth" Size="Size.Small" />
            <span class="tab-badge">31</span>
        </span>
        <span class="tab-btn-label">Monthly</span>
    </button>
    <button class="tab-btn @(ActiveTab == 3 ? "active" : "")" @onclick="() => OnTabSelected.InvokeAsync(3)" style="@ListTabStyle">
        <span class="tab-btn-icon">
            @if (string.IsNullOrEmpty(ListLetter)) {
                <MudIcon Icon="@Icons.Material.Filled.Checklist" Size="Size.Small" />
            } else {
                <span class="tab-list-letter">@ListLetter</span>
            }
        </span>
        <span class="tab-btn-label">@(string.IsNullOrEmpty(ListName) ? "Lists" : ListName)</span>
    </button>
    <button class="tab-btn @(ActiveTab == 4 ? "active" : "")" @onclick="() => OnTabSelected.InvokeAsync(4)">
        <span class="tab-btn-icon">
            <MudIcon Icon="@Icons.Material.Filled.MoreVert" Size="Size.Small" />
        </span>
        <span class="tab-btn-label">More</span>
    </button>
</div>

@code {
    [Parameter]
    public int ActiveTab { get; set; }

    [Parameter]
    public string ListLetter { get; set; } = string.Empty;

    [Parameter]
    public string ListName { get; set; } = string.Empty;

    [Parameter]
    public string ListTabStyle { get; set; } = string.Empty;

    [Parameter]
    public EventCallback<int> OnTabSelected { get; set; }
}
