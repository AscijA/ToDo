<div class="@GetHeaderClass()"
     role="@GetHeaderRole()"
     tabindex="@GetHeaderTabIndex()"
     @onclick="HandleHeaderClick"
     @onkeydown="HandleHeaderKeyDown">
   @if (ShowBackButton) {
      <MudIconButton Icon="@Icons.Material.Filled.ArrowBack"
                     aria-label="Back"
                     Color="Color.Primary"
                     Size="Size.Small"
                     tabindex="-1" />
   }
   else if (!string.IsNullOrEmpty(Icon)) {
      <MudIconButton Icon="@Icon" Size="Size.Small" Color="Color.Secondary" OnClick="() => { }" Ripple="false"/>
   }
   <MudText Typo="Typo.h6">@Title</MudText>
</div>

@code {
   [Parameter]
   public string Title { get; set; } = string.Empty;

   [Parameter]
   public bool ShowBackButton { get; set; }

   [Parameter]
   public string? Icon { get; set; }

   [Parameter]
   public EventCallback OnBack { get; set; }

   private string GetHeaderClass() => ShowBackButton
      ? "mobile-page-header mobile-page-header-clickable"
      : "mobile-page-header";

   private string? GetHeaderRole() => ShowBackButton ? "button" : null;

   private int? GetHeaderTabIndex() => ShowBackButton ? 0 : null;

   private async Task HandleHeaderClick() {
      if (ShowBackButton) {
         await OnBack.InvokeAsync();
      }
   }

   private async Task HandleHeaderKeyDown(KeyboardEventArgs args) {
      if (ShowBackButton && (args.Key == "Enter" || args.Key == " ")) {
         await OnBack.InvokeAsync();
      }
   }
}
