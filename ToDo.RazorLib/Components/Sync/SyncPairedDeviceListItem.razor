@using ToDo.RazorLib.Services
@inject IDialogService DialogService

<MudListItem Value="@Device">
	<div class="d-flex align-center mud-width-full">
		<MudStack Spacing="0">
			<MudText Typo="Typo.body2">@Device.DeviceName</MudText>
			<MudText Typo="Typo.caption" Color="@(Device.IsOnline ? Color.Success : Color.Secondary)">
				@(Device.IsOnline ? "Online" : "Offline") - @Device.Address
			</MudText>
			@if (Device.NextRetryAt is { } nextRetryAt && nextRetryAt > DateTimeOffset.Now) {
				<MudText Typo="Typo.caption" Color="Color.Warning">
					Retry after @nextRetryAt.ToLocalTime().ToString("HH:mm")
				</MudText>
			}
			else if (!string.IsNullOrWhiteSpace(Device.LastSyncError)) {
				<MudText Typo="Typo.caption" Color="Color.Warning">@Device.LastSyncError</MudText>
			}
		</MudStack>
		<MudSpacer />
		<MudIconButton Icon="@Icons.Material.Filled.MoreVert"
					   aria-label="Open paired device actions"
					   Size="Size.Small"
					   Color="Color.Primary"
					   OnClick="OpenActionsAsync" />
	</div>
</MudListItem>

@code {
	[Parameter, EditorRequired]
	public PairedSyncDevice Device { get; set; } = null!;

	[Parameter]
	public EventCallback OnDevicesChanged { get; set; }

	private async Task OpenActionsAsync() {
		var parameters = new DialogParameters {
			[nameof(SyncPairedDeviceActionsDialog.Device)] = Device,
			[nameof(SyncPairedDeviceActionsDialog.OnDevicesChanged)] = OnDevicesChanged
		};

		await DialogService.ShowAsync<SyncPairedDeviceActionsDialog>("Device Actions", parameters);
	}
}
