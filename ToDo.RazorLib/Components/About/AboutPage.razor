<MudPaper Class="panel-daily mud-height-full rounded" Elevation="1" Style="height: 100%; max-height: 100%; overflow-y: auto; box-sizing: border-box;">
    <div>
        <MudStack Spacing="4">
            <div class="about-page-header" style="display: flex; align-items: center; gap: 4px;">
                @if (ShowBackButton) {
                    <MudIconButton Icon="@Icons.Material.Filled.ArrowBack"
                                   aria-label="Back"
                                   Color="Color.Primary"
                                   Size="Size.Small"
                                   OnClick="OnBack" />
                }
                <MudText Typo="Typo.h6">About</MudText>
            </div>

            <MudStack Spacing="2" AlignItems="AlignItems.Center" Class="pa-4">
                <MudText Typo="Typo.h4" Color="Color.Primary">To Do</MudText>
                <MudText Typo="Typo.caption" Color="Color.Secondary">Version 1.0.0</MudText>
            </MudStack>

            <MudDivider />

            <MudText Typo="Typo.body1">
                A cross-platform planner and task management app built with .NET MAUI and Blazor.
            </MudText>

            <MudDivider />

            <MudText Typo="Typo.subtitle1" Color="Color.Primary">Features</MudText>
            <MudList T="string" Dense="true">
                <MudListItem Icon="@Icons.Material.Filled.CalendarToday" Text="Daily planner" />
                <MudListItem Icon="@Icons.Material.Filled.CalendarViewWeek" Text="Weekly planner" />
                <MudListItem Icon="@Icons.Material.Filled.CalendarMonth" Text="Monthly planner" />
                <MudListItem Icon="@Icons.Material.Filled.Checklist" Text="Custom task lists" />
                <MudListItem Icon="@Icons.Material.Filled.Sync" Text="Local network sync between devices" />
                <MudListItem Icon="@Icons.Material.Filled.Palette" Text="Multiple themes with custom color support" />
            </MudList>

            <MudDivider />

            <MudText Typo="Typo.subtitle1" Color="Color.Primary">Tech Stack</MudText>
            <MudSimpleTable Dense="true" Bordered="false" Elevation="0">
                <tbody>
                    <tr>
                        <td><MudText Typo="Typo.body2" Color="Color.Secondary">Framework</MudText></td>
                        <td><MudText Typo="Typo.body2">.NET 10 / MAUI</MudText></td>
                    </tr>
                    <tr>
                        <td><MudText Typo="Typo.body2" Color="Color.Secondary">UI</MudText></td>
                        <td><MudText Typo="Typo.body2">Blazor + MudBlazor</MudText></td>
                    </tr>
                    <tr>
                        <td><MudText Typo="Typo.body2" Color="Color.Secondary">Database</MudText></td>
                        <td><MudText Typo="Typo.body2">SQLite (EF Core)</MudText></td>
                    </tr>
                    <tr>
                        <td><MudText Typo="Typo.body2" Color="Color.Secondary">Platforms</MudText></td>
                        <td><MudText Typo="Typo.body2">Windows, Android</MudText></td>
                    </tr>
                </tbody>
            </MudSimpleTable>

            <MudDivider />

            <MudText Typo="Typo.subtitle1" Color="Color.Primary">Author</MudText>
            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                <MudIcon Icon="@Icons.Material.Filled.Person" Color="Color.Secondary" />
                <MudText Typo="Typo.body1">AscijA</MudText>
            </MudStack>

            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                <MudIcon Icon="@Icons.Material.Filled.Code" Color="Color.Secondary" />
                <MudLink Href="https://github.com/AscijA/ToDo" Target="_blank" Color="Color.Primary">
                    github.com/AscijA/ToDo
                </MudLink>
            </MudStack>

        </MudStack>
    </div>
</MudPaper>

@code {
    [Parameter]
    public bool ShowBackButton { get; set; }

    [Parameter]
    public EventCallback OnBack { get; set; }
}