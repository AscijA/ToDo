@inject ISnackbar Snackbar
@inject ITaskService TaskService

<MudForm Model="@Daily" @ref="itemForm" ReadOnly="IsHistory()">
   <div class="d-flex align-center gap-4">
      <MudCheckBox @bind-Value="Daily.IsDone"
                   @bind-Value:after="SaveChanges"
                   Color="Color.Primary"
                   Dense="true"
                   Size="Size.Small" />

      <MudTextField @bind-Value="Daily.Timeslot"
                    @bind-Value:after="SaveChanges"
                    For="@(() => Daily.Timeslot)"
                    Label=""
                    Placeholder="09:00-11:00"
                    Class=@($"timeslot flex-grow-0 {(Daily.IsDone ? "done-item" : "")}")
                    Mask="@timeSlotMask"
                    Margin="Margin.Dense"
                    Underline="false"
                    Error="timeslotValid"
                    @ref="timeslotRef" />

      <MudTextField @bind-Value="Daily.Title"
                    @bind-Value:after="SaveChanges"
                    For="@(() => Daily.Title)"
                    Label=""
                    Margin="Margin.Dense"
                    Underline="@(string.IsNullOrWhiteSpace(Daily.Title))"
                    Class="@(Daily.IsDone ? "done-item" : "")" />

      <MudIconButton Icon="@Icons.Material.Filled.Info"
                     Color="Color.Primary"
                     Size="Size.Small"
                     OnClick="OnExpandCollapseClick" />

      <MudIconButton Icon="@Icons.Material.Filled.Delete"
                     Color="Color.Error"
                     Size="Size.Small"
                     OnClick="OnDeleteClick" />
   </div>
   <MudCollapse @bind-Expanded="@_expanded">
      <MudTextField @bind-Value="Daily.Description"
                    @bind-Value:after="SaveChanges"
                    For="@(() => Daily.Description)"
                    Margin="Margin.Dense" />
   </MudCollapse>

</MudForm>

@code {
   // Parameters
   [Parameter]
   public DailyItemDTO Daily { get; set; } = new();

   [Parameter]
   public DateOnly date { get; set; } = DateOnly.FromDateTime(DateTime.Now);

   [Parameter]
   public EventCallback OnSaved { get; set; }

   [Parameter]
   public bool AutoFocus { get; set; } = false;

   // Private fields
   private MudForm? itemForm;
   private MudTextField<string>? timeslotRef;
   private IMask timeSlotMask = new PatternMask("00:00-00:00");
   private bool timeslotValid;
   private bool _expanded;

   // Lifecycle
   protected override async Task OnAfterRenderAsync(bool firstRender) {
      if (firstRender && Daily.TaskDefinitionId == Guid.Empty && AutoFocus) {
         await (timeslotRef?.FocusAsync().AsTask() ?? Task.CompletedTask);
      }
   }

   // Event handlers
   private void OnExpandCollapseClick() {
      _expanded = !_expanded;
   }

   private async Task OnDeleteClick(MouseEventArgs args) {
      try {
         await TaskService.DeleteTaskAsync(Daily.OccurrenceId);
         await OnSaved.InvokeAsync();
      }
      catch (Exception ex) {
         Debug.WriteLine($"Failed to delete: {ex.Message}");
         Snackbar.Add("Error deleting task", Severity.Error);
      }
   }

   private async Task SaveChanges() {
      if (!string.IsNullOrEmpty(Daily.Timeslot) && Daily.Timeslot.Length < 11) {
         timeslotValid = false;
         Debug.WriteLine("Timeslot is incomplete. Aborting auto-save.");
         return;
      }
      timeslotValid = true;
      var validationContext = new ValidationContext(Daily);
      var validationResults = new List<ValidationResult>();

      bool isModelSafeToSave = Validator.TryValidateObject(Daily, validationContext, validationResults, validateAllProperties: true);

      if (isModelSafeToSave) {
         try {
            if (Daily.TaskDefinitionId == Guid.Empty) {
               Debug.WriteLine("Insert New");
               await TaskService.AddTaskToDateAsync(date, Daily);

               await OnSaved.InvokeAsync();
               return;
            }

            await TaskService.UpdateAsync(Daily);

            await OnSaved.InvokeAsync();
         }
         catch (Exception ex) {
            Debug.WriteLine($"Failed to save: {ex.Message}");
            Snackbar.Add("Error saving data", Severity.Error);
         }
      }
   }

   // Helpers
   private bool IsHistory() {
      return date < DateOnly.FromDateTime(DateTime.Now);
   }
}