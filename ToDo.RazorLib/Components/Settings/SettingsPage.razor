@using ToDo.RazorLib.Services
@inject ISettingsService SettingsService
@inject IStartupSettingsService StartupSettingsService
@inject ThemeStoreInterop ThemeStore

<MobilePageHeader Title="Settings"
                  ShowBackButton="ShowBackButton"
                  OnBack="OnBack" />

<MudSelect T="string" @bind-Value="_appearance" @bind-Value:after="SaveSettingsAsync" Label="Appearance">
   <MudSelectItem Value="@("Light")">Light</MudSelectItem>
   <MudSelectItem Value="@("Dark")">Dark</MudSelectItem>
   <MudSelectItem Value="@("System")">Follow System</MudSelectItem>
</MudSelect>

<MudSelect T="string" @bind-Value="_themeName" @bind-Value:after="SaveSettingsAsync" Label="Theme">
   <MudSelectItem Value="@("ODP")">One Dark Pro</MudSelectItem>
   <MudSelectItem Value="@("Solarized")">Solarized</MudSelectItem>
   <MudSelectItem Value="@("Blue")">Blue Night</MudSelectItem>
   <MudSelectItem Value="@("Green")">Green</MudSelectItem>
   <MudSelectItem Value="@("Custom")">Custom</MudSelectItem>
</MudSelect>

@if (_themeName == "Custom") {
   <MudGrid>
      <MudItem xs="6">
         <MudColorPicker Value="_customPrimaryColor" ValueChanged="OnCustomPrimaryChanged" Text="_customPrimary" Label="Primary" Style="@($"color: {_customPrimary};")" />
      </MudItem>
      <MudItem xs="6">
         <MudColorPicker Value="_customSecondaryColor" ValueChanged="OnCustomSecondaryChanged" Text="_customSecondary" Label="Secondary" Style="@($"color: {_customSecondary};")" />
      </MudItem>
      <MudItem xs="6">
         <MudColorPicker Value="_customBackgroundColor" ValueChanged="OnCustomBackgroundChanged" Text="_customBackground" Label="Background" Style="@($"color: {_customBackground};")" />
      </MudItem>
      <MudItem xs="6">
         <MudColorPicker Value="_customSurfaceColor" ValueChanged="OnCustomSurfaceChanged" Text="_customSurface" Label="Surface" Style="@($"color: {_customSurface};")" />
      </MudItem>
   </MudGrid>
}

<MudDivider />

@if (!(OperatingSystem.IsAndroid() || OperatingSystem.IsIOS())) {
   <MudText Typo="Typo.h6">Layout</MudText>

   <MudSwitch T="bool" @bind-Value="_bigOnLeft" @bind-Value:after="SaveSettingsAsync" Label="Big Container on Left" Color="Color.Primary" />
   <MudSwitch T="bool" @bind-Value="_minimizeToTray" @bind-Value:after="SaveSettingsAsync" Label="Minimize to Tray on Close" Color="Color.Primary" />

   @if (_startupSettingsState.IsSupported) {
      <MudSwitch T="bool" @bind-Value="_startWithWindows" @bind-Value:after="SaveSettingsAsync" Label="Start with Windows" Color="Color.Primary" Disabled="@IsStartupRegistrationLocked" />
      <MudSwitch T="bool" @bind-Value="_startupMinimized" @bind-Value:after="SaveSettingsAsync" Label="Startup Minimized" Color="Color.Primary" Disabled="@(!_startWithWindows)" />
   }

   <MudSelect T="string" @bind-Value="_slotBig" @bind-Value:after="SaveSettingsAsync" Label="Big Slot">
      <MudSelectItem Value="@("Daily")">Daily Planner</MudSelectItem>
      <MudSelectItem Value="@("Weekly")">Weekly Planner</MudSelectItem>
      <MudSelectItem Value="@("Monthly")">Monthly Planner</MudSelectItem>
   </MudSelect>

   <MudSelect T="string" @bind-Value="_slotSmallTop" @bind-Value:after="SaveSettingsAsync" Label="Small Top Slot">
      <MudSelectItem Value="@("Daily")">Daily Planner</MudSelectItem>
      <MudSelectItem Value="@("Weekly")">Weekly Planner</MudSelectItem>
      <MudSelectItem Value="@("Monthly")">Monthly Planner</MudSelectItem>
   </MudSelect>

   <MudSelect T="string" @bind-Value="_slotSmallBottom" @bind-Value:after="SaveSettingsAsync" Label="Small Bottom Slot">
      <MudSelectItem Value="@("Daily")">Daily Planner</MudSelectItem>
      <MudSelectItem Value="@("Weekly")">Weekly Planner</MudSelectItem>
      <MudSelectItem Value="@("Monthly")">Monthly Planner</MudSelectItem>
   </MudSelect>
}
      

@code {
   [Parameter]
   public EventCallback OnSaved { get; set; }

   [Parameter]
   public bool ShowBackButton { get; set; }

   [Parameter]
   public EventCallback OnBack { get; set; }

   private string _appearance = "System";
   private string _themeName = "ODP";
   private bool _bigOnLeft = true;
   private string _slotBig = "Daily";
   private string _slotSmallTop = "Weekly";
   private string _slotSmallBottom = "Monthly";
   private bool _startWithWindows;
   private bool _lastStartWithWindows;
   private bool _startupMinimized;
   private bool _minimizeToTray;
   private StartupSettingsState _startupSettingsState = new(false, false, false, false);
   private bool IsStartupRegistrationLocked => _startupSettingsState.IsDisabledByUser || _startupSettingsState.IsDisabledByPolicy;

   private string _customPrimary = "#C678DD";
   private string _customSecondary = "#61AFEF";
   private string _customBackground = "#282C34";
   private string _customSurface = "#21252B";
   private MudBlazor.Utilities.MudColor _customPrimaryColor = new("#C678DD");
   private MudBlazor.Utilities.MudColor _customSecondaryColor = new("#61AFEF");
   private MudBlazor.Utilities.MudColor _customBackgroundColor = new("#282C34");
   private MudBlazor.Utilities.MudColor _customSurfaceColor = new("#21252B");

   protected override async Task OnInitializedAsync() {
      _appearance = SettingsService.Get("Appearance", "System");
      _themeName = SettingsService.Get("Theme", "ODP");
      _bigOnLeft = SettingsService.Get("BigOnLeft", "true") == "true";
      _startupMinimized = SettingsService.Get("StartupMinimized", "false") == "true";
      _minimizeToTray = SettingsService.Get("MinimizeToTray", "false") == "true";
      _slotBig = SettingsService.Get("Slot_Big", "Daily");
      _slotSmallTop = SettingsService.Get("Slot_SmallTop", "Weekly");
      _slotSmallBottom = SettingsService.Get("Slot_SmallBottom", "Monthly");

      _customPrimary = SettingsService.Get("Custom_Primary", "#C678DD");
      _customSecondary = SettingsService.Get("Custom_Secondary", "#61AFEF");
      _customBackground = SettingsService.Get("Custom_Background", "#282C34");
      _customSurface = SettingsService.Get("Custom_Surface", "#21252B");
      LoadCustomColorValues();
      await RefreshStartupSettingsAsync();
   }

   private void LoadCustomColorValues() {
      _customPrimaryColor = CreateColor(_customPrimary, "#C678DD");
      _customSecondaryColor = CreateColor(_customSecondary, "#61AFEF");
      _customBackgroundColor = CreateColor(_customBackground, "#282C34");
      _customSurfaceColor = CreateColor(_customSurface, "#21252B");
   }

   private static MudBlazor.Utilities.MudColor CreateColor(string value, string fallback) {
      try {
         return new MudBlazor.Utilities.MudColor(value);
      }
      catch {
         return new MudBlazor.Utilities.MudColor(fallback);
      }
   }

   private async Task OnCustomPrimaryChanged(MudBlazor.Utilities.MudColor color) {
      _customPrimaryColor = color;
      _customPrimary = color.ToString(MudBlazor.Utilities.MudColorOutputFormats.Hex);
      await SaveSettingsAsync();
   }

   private async Task OnCustomSecondaryChanged(MudBlazor.Utilities.MudColor color) {
      _customSecondaryColor = color;
      _customSecondary = color.ToString(MudBlazor.Utilities.MudColorOutputFormats.Hex);
      await SaveSettingsAsync();
   }

   private async Task OnCustomBackgroundChanged(MudBlazor.Utilities.MudColor color) {
      _customBackgroundColor = color;
      _customBackground = color.ToString(MudBlazor.Utilities.MudColorOutputFormats.Hex);
      await SaveSettingsAsync();
   }

   private async Task OnCustomSurfaceChanged(MudBlazor.Utilities.MudColor color) {
      _customSurfaceColor = color;
      _customSurface = color.ToString(MudBlazor.Utilities.MudColorOutputFormats.Hex);
      await SaveSettingsAsync();
   }

   private async Task SaveSettingsAsync() {
      SettingsService.Set("Appearance", _appearance);
      SettingsService.Set("Theme", _themeName);
      SettingsService.Set("BigOnLeft", _bigOnLeft.ToString().ToLower());
      SettingsService.Set("StartupMinimized", _startupMinimized.ToString().ToLower());
      SettingsService.Set("MinimizeToTray", _minimizeToTray.ToString().ToLower());
      SettingsService.Set("Slot_Big", _slotBig);
      SettingsService.Set("Slot_SmallTop", _slotSmallTop);
      SettingsService.Set("Slot_SmallBottom", _slotSmallBottom);

      SettingsService.Set("Custom_Primary", _customPrimary);
      SettingsService.Set("Custom_Secondary", _customSecondary);
      SettingsService.Set("Custom_Background", _customBackground);
      SettingsService.Set("Custom_Surface", _customSurface);

      await SaveStartupSettingsAsync();
      await PersistSplashThemeAsync();
      await OnSaved.InvokeAsync();
   }

   private async Task RefreshStartupSettingsAsync() {
      _startupSettingsState = await StartupSettingsService.GetStateAsync();
      _startWithWindows = _startupSettingsState.IsEnabled;
      _lastStartWithWindows = _startWithWindows;
   }

   private async Task SaveStartupSettingsAsync() {
      if (!_startupSettingsState.IsSupported || _startWithWindows == _lastStartWithWindows) {
         return;
      }

      _startupSettingsState = await StartupSettingsService.SetEnabledAsync(_startWithWindows);
      _startWithWindows = _startupSettingsState.IsEnabled;
      _lastStartWithWindows = _startWithWindows;
   }

   private async Task PersistSplashThemeAsync() {
      var isDark = _appearance != "Light";
      var theme = _themeName switch {
         "Blue" => Themes.Blue,
         "Solarized" => Themes.Solarized,
         "Green" => Themes.Green,
         "Custom" => Themes.CreateCustomTheme(_customPrimary, _customSecondary, _customBackground, _customSurface),
         _ => Themes.OneDarkPro
      };
      var (primary, background) = Themes.GetColors(theme, isDark);
      await ThemeStore.PersistAsync(primary, background, isDark);
   }
}
