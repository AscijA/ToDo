@inject IDailyPlanService TaskService
@inject ISettingsService SettingsService
@inject SyncDataRefreshService SyncDataRefresh
@implements IDisposable

<PlannerDateHeader Title="@($"Week {GetWeekNumber(Date)} - {Date:dd.MM.yyyy}")"
					  SelectedDate="selectedDateTime"
					  PreviousLabel="Previous week"
					  NextLabel="Next week"
					  OnPrevious="GoToPreviousWeek"
					  OnNext="GoToNextWeek"
					  OnToday="GoToToday"
					  OnDateSelected="OnDateSelected" />

@foreach (var item in WeeklyItems) {
	<WeeklyItem @key="item.TaskDefinitionId"
				Weekly="item"
				OnSaved="RefreshListAsync" />
}

@if (Date >= GetWeekStart(DateOnly.FromDateTime(DateTime.Now))) {
	<WeeklyItem Weekly="newItem"
				@key="Guid.NewGuid()"
				OnSaved="RefreshListAsync"
				AutoFocus="shouldAutoFocus" />
}

@code {
	private const string DatePrefKey = "LastViewedWeeklyDate";
	private WeeklyItemDTO newItem = new();
	public List<WeeklyItemDTO> WeeklyItems { get; set; } = new();
	private DateOnly Date { get; set; }
	private DateTime selectedDateTime;
	private bool shouldAutoFocus;

	protected override async Task OnInitializedAsync() {
		SyncDataRefresh.RefreshRequested += OnSyncDataRefreshRequested;
		var savedDateStr = SettingsService.Get(DatePrefKey, string.Empty);
		if (!string.IsNullOrEmpty(savedDateStr) && DateOnly.TryParse(savedDateStr, out var parsedDate)) {
			Date = GetWeekStart(parsedDate);
		}
		else {
			Date = GetWeekStart(DateOnly.FromDateTime(DateTime.Now));
		}

		selectedDateTime = Date.ToDateTime(new TimeOnly(0, 0));
		await LoadTasksAsync();
	}

	private async Task LoadTasksAsync() {
		WeeklyItems = await TaskService.GetAllWeeklyAsync(Date);
		newItem = new WeeklyItemDTO { Date = Date };
	}

	private async Task RefreshListAsync() {
		shouldAutoFocus = true;
		await LoadTasksAsync();
	}

	private async Task GoToPreviousWeek() {
		Date = Date.AddDays(-7);
		await SyncAndReloadAsync();
	}

	private async Task GoToNextWeek() {
		Date = Date.AddDays(7);
		await SyncAndReloadAsync();
	}

	private async Task GoToToday() {
		await OnDateSelected(DateTime.Now);
	}

	private async Task OnDateSelected(DateTime? newDate) {
		if (newDate.HasValue) {
			Date = GetWeekStart(DateOnly.FromDateTime(newDate.Value));
			selectedDateTime = Date.ToDateTime(new TimeOnly(0, 0));
			await SyncAndReloadAsync();
		}
	}

	private async Task SyncAndReloadAsync() {
		shouldAutoFocus = false;
		selectedDateTime = Date.ToDateTime(new TimeOnly(0, 0));
		SettingsService.Set(DatePrefKey, Date.ToString("yyyy-MM-dd"));
		await LoadTasksAsync();
	}

	private void OnSyncDataRefreshRequested() {
		_ = InvokeAsync(async () => {
			shouldAutoFocus = false;
			await LoadTasksAsync();
			StateHasChanged();
		});
	}

	public void Dispose() {
		SyncDataRefresh.RefreshRequested -= OnSyncDataRefreshRequested;
	}

	private static DateOnly GetWeekStart(DateOnly date) {
		var diff = (7 + ((int)date.DayOfWeek - (int)DayOfWeek.Monday)) % 7;
		return date.AddDays(-diff);
	}

	private static int GetWeekNumber(DateOnly date) {
		return System.Globalization.ISOWeek.GetWeekOfYear(date.ToDateTime(new TimeOnly(0, 0)));
	}
}
