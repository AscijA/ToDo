<aside class="sidebar" aria-label="Primary">
	<div class="sidebar-top" @ref="ListsContainer">
		<MudIconButton Icon="@Icons.Material.Filled.Schedule"
						  aria-label="Schedule"
						  Color="@(ActivePage == DesktopPage.Planner ? Color.Primary : Color.Default)"
						  OnClick="OnPlannerSelected" />

		@foreach (var list in TaskLists) {
			<div class="sidebar-list-item @(SelectedListId == list.Id ? "selected" : "")"
				  style="--list-color: @list.Color"
				  @onclick="() => OnListSelected.InvokeAsync(list.Id)">
				@GetIconLetter(list.Name)
			</div>
		}
	</div>

	<div class="sidebar-bottom">
		<MudIconButton Icon="@Icons.Material.Filled.Add"
						  aria-label="New List"
						  Color="Color.Primary"
						  OnClick="OnAddNewList" />

		<div class="sidebar-settings-group">
			<div class="sidebar-expandable-items @(_expanded ? "expanded" : "")">
				<MudIconButton Icon="@Icons.Material.Filled.Info"
								  aria-label="About"
								  Size="Size.Small"
								  Color="@(ActivePage == DesktopPage.About ? Color.Primary : Color.Default)"
								  OnClick="OnAboutSelected" />
				<MudIconButton Icon="@Icons.Material.Filled.Sync"
								  aria-label="Sync"
								  Size="Size.Small"
								  Color="@(ActivePage == DesktopPage.Sync ? Color.Primary : Color.Default)"
								  OnClick="OnSyncSelected" />
			</div>
			<MudIconButton Icon="@Icons.Material.Filled.KeyboardArrowUp"
							  aria-label="@(_expanded ? "Hide menu" : "Show menu")"
							  Size="Size.Small"
							  Class="@($"sidebar-toggle-arrow {(_expanded ? "rotated" : "")}")"
							  OnClick="() => _expanded = !_expanded"
							  Ripple="false" />
			<MudIconButton Icon="@Icons.Material.Filled.Settings"
							  aria-label="Settings"
							  Color="@(ActivePage == DesktopPage.Settings ? Color.Primary : Color.Default)"
							  OnClick="OnSettingsSelected" />
		</div>
	</div>
</aside>

@code {
	private bool _expanded;

	public ElementReference ListsContainer;

	[Parameter]
	public IReadOnlyList<TaskListDto> TaskLists { get; set; } = Array.Empty<TaskListDto>();

	[Parameter]
	public DesktopPage ActivePage { get; set; }

	[Parameter]
	public Guid SelectedListId { get; set; }

	[Parameter]
	public EventCallback OnPlannerSelected { get; set; }

	[Parameter]
	public EventCallback<Guid> OnListSelected { get; set; }

	[Parameter]
	public EventCallback OnAddNewList { get; set; }

	[Parameter]
	public EventCallback OnSyncSelected { get; set; }

	[Parameter]
	public EventCallback OnSettingsSelected { get; set; }

	[Parameter]
	public EventCallback OnAboutSelected { get; set; }

	private static string GetIconLetter(string name) =>
		string.IsNullOrWhiteSpace(name) ? "?" : name.Trim()[0].ToString().ToUpperInvariant();
}
